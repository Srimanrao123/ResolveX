# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Required for custom ReturnGuard sessions and private evidence storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AUTH_SECRET=generate-a-long-random-secret

# Resend sends Supabase Auth's OTP emails through its SMTP service.
# Configure the same key as the SMTP password in Supabase Dashboard → Auth → SMTP.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=ReturnGuard <login@yourdomain.com>

# Used only by server-side AI routes; do not expose with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxx
